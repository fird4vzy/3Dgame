{
  "name": "lumenpost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tiny planet. A bag full of light. Everyone's waiting.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,glsl,css}\" \"tests/**/*.ts\"",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:play": "node tests/e2e/playthrough.mjs",
    "shoot:character": "node tools/shoot-character.mjs",
    "meshy": "node tools/meshy.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "lit": "^3.3.3",
    "postprocessing": "^6.39.4",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/node": "^22.20.1",
    "@types/three": "^0.180.0",
    "eslint": "^9.17.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
